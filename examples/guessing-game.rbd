let loop = true;

while(loop) {
    print("Is rust the best language? [Y/N]: ");
    let a = input();
    if (a == "Y" or a == "y") {
        println("Correct");
        loop = false;
    } else if (a == "N" or a == "n") {
        println("Incorrect");
        loop = false;
    } else {
        println("Invalid Input try again");
    }
}
